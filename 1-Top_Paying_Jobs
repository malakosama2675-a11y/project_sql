/*
Question:
What are the top 5 highest-paying global remote ('Anywhere') Business Analyst 
job postings, and which companies are offering them?

Architectural Value:
- Benchmarks the financial ceiling for the target profession by isolating 
  the highest compensation packages while explicitly filtering out missing data.
*/

SELECT
    job_id,
    job_title_short,
    job_location,
    job_schedule_type,
    salary_year_avg,
    job_posted_date,
    name as company

FROM job_postings_fact
left JOIN company_dim ON job_postings_fact.company_id =company_dim.company_id
where job_title_short = 'Business Analyst'
and job_location = 'Anywhere'
and salary_year_avg IS NOT NULL 
order BY salary_year_avg DESC
limit 5 ;
 
 
 